# Copy to .env (local) or .env.docker (compose).
# DigitalOcean App Platform injects the same keys via .do/app.yaml (no .env file there).

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
REDIS_KEY_PREFIX=jobs
CELERY_QUEUE=jobs
CELERY_CONCURRENCY=3
CELERY_PREFETCH_MULTIPLIER=1
CELERY_TASK_ALWAYS_EAGER=false

# --- Job processing ---
MAX_RETRIES=3
BASE_BACKOFF_SECONDS=0.2
RETRY_JITTER_RATIO=0.25
MOCK_WORK_SECONDS=0.5
IDEMPOTENCY_TTL_SECONDS=86400
JOB_TTL_SECONDS=604800
STUCK_RUNNING_SECONDS=300
REAPER_INTERVAL_SECONDS=30
PURGE_INTERVAL_SECONDS=60
JOB_LOCK_TIMEOUT_SECONDS=5
JOB_LOCK_BLOCKING_TIMEOUT_SECONDS=5
DLQ_LIST_DEFAULT_LIMIT=100

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Docker Compose host port publish (compose variable substitution) ---
REDIS_PUBLISH_PORT=6379
API_PUBLISH_PORT=8000
